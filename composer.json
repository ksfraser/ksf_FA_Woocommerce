{
    "name": "ksfraser/export-woocommerce",
    "description": "FrontAccounting module for exporting data to WooCommerce via REST API",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "/home/kevin/Documents/ksf_Workflow"
        }
    ],
    "require": {
        "php": ">=7.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mysqli": "*",
        "automattic/woocommerce": "^3.1",
        "ksfraser/fa-hooks": "dev-main",
        "ksfraser/ksf-modules-dao": "^0.3",
        "ksfraser/staging-dto": "^0.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "ksfraser/famock": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\Woocommerce\\": "src/Ksfraser/frontaccounting/Woocommerce/",
            "ksfraser\\FrontAccounting\\Woocommerce\\Tests\\": "tests/"
        }
    },
    "config": {
        "minimum-stability": "stable",
        "prefer-stable": true,
        "platform": {
            "php": "7.4.33"
        }
    }
}
